# Configuración pública del SDK Web de Firebase / Google Identity Platform (Split PWA)
# Copiar este archivo como `.env.local` para conectar con el proyecto GCP (`split-swim-app`).
# Si estas variables se dejan vacías o no se definen, Split opera 100% en modo Local-First sobre Dexie (IndexedDB).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=split-swim-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=split-swim-app
VITE_FIREBASE_APP_ID=
